{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
    "lib": ["es2023"],
		"module": "NodeNext",
    "target": "es2022",

    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
		"resolveJsonModule": true,
		"moduleResolution": "NodeNext",
		"allowImportingTsExtensions": true,

		"importHelpers": true,
		"noEmit": true,
		"emitDeclarationOnly": false,
	},
}
