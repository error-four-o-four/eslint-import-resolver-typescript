{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2018",
    "module": "commonjs",
    "rootDirs": ["./src", "./generated"],
    "baseUrl": "./",
    "paths": {
      "@generated/*": ["generated/*"],
      "@src/*": ["src/*"]
    }
  },
  "include": ["src/**/*", "generated/**/*"],
  "exclude": ["node_modules"]
}