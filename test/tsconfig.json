{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,

		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,

		"baseUrl": "./",
		"paths": {
			"@src/*": ["../src/*"],
			"@e2e/*": ["e2e/*"],
			"@unit/*": ["unit/*"],
			"@utils/*": ["utils/*"],
		},
		"types": ["node", "vitest"],
	},
	"include": ["**/*.ts"],
	"exclude": ["./fixtures"]
}