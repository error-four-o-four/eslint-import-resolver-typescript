{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,

		"baseUrl": "../src",
		"paths": {
			"@e2e/*": ["../test/e2e/*"],
			"@unit/*": ["../test/unit/*"],
			"@utils/*": ["../test/utils/*"],
		},
		"types": ["node", "vitest"],
	},
	"include": ["**/*.ts", "../src/**/*.ts"],
	"exclude": ["../fixtures"]
}