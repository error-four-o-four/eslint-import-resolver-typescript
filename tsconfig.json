{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"lib": ["es2023"],
    "target": "es2022",
		"module": "NodeNext",

		"strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
		"resolveJsonModule": true,

		"allowImportingTsExtensions": true,
		"importHelpers": true,

		"noEmit": true,
		"emitDeclarationOnly": false,

		"baseUrl": "./src",
		"paths": {
			"@e2e/*": ["../test/e2e/*"],
			"@unit/*": ["../test/unit/*"],
			"@utils/*": ["../test/utils/*"],
		},
		"types": ["node", "vitest"],
	},
	"include": [
		"src/**/*.ts",
		"test/**/*.ts",
	],
	"exclude": [
		"node_modules",
		"**/node_modules",
		"dist",
		"test/fixtures"
	],
}