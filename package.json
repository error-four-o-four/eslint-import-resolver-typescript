{
  "name": "eslint-import-resolver-typescript",
  "version": "0.0.0",
  "type": "module",
  "description": "This plugin adds `TypeScript` support to `eslint-plugin-import`",
  "repository": "git+https://github.com/error-four-o-four/eslint-import-resolver-typescript",
  "author": "error-four-o-four",
  "license": "ISC",
  "keywords": [
    "typescript",
    "eslint",
    "import",
    "resolver",
    "plugin"
  ],
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=21.1.0"
  },
  "exports": {
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "//lint:debug": "eslint --config test/e2e/eslint.config.js test/fixtures/**/*.ts",
    "//lint:check": "eslint .",
    "//lint:fix": "eslint . --fix",
    "lint:tsc": "tsc -p tsconfig.json --noEmit",
    "dev": "pkgroll --watch --export-condition=node",
    "build": "pkgroll --clean-dist --export-condition=node",
    "test:e2e": "vitest --config test/vitest.config.e2e.ts",
    "test:unit": "vitest --config test/vitest.config.unit.ts"
  },
  "peerDependencies": {
    "eslint": "*"
  },
  "dependencies": {
    "@types/debug": "^4.1.12",
    "@types/eslint": "^8.56.10",
    "@types/is-core-module": "^2.2.2",
    "@types/node": "^20.14.2",
    "debug": "^4.3.5",
    "eslint-plugin-import-x": "^0.5.1",
    "get-tsconfig": "^4.7.5",
    "is-core-module": "^2.13.1",
    "slash": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1.1.0",
    "@tsconfig/bun": "^1.0.6",
    "@tsconfig/create-react-app": "^2.0.5",
    "@tsconfig/docusaurus": "^2.0.3",
    "@tsconfig/ember": "^3.0.8",
    "@tsconfig/next": "^2.0.3",
    "@tsconfig/node-lts": "^20.1.3",
    "@tsconfig/node10": "^1.0.11",
    "@tsconfig/node16": "^16.1.3",
    "@tsconfig/node18": "^18.2.4",
    "@tsconfig/node20": "^20.1.4",
    "@tsconfig/node22": "^22.0.0",
    "@tsconfig/nuxt": "^2.0.3",
    "@tsconfig/react-native": "^3.0.5",
    "@tsconfig/vite-react": "^3.0.2",
    "eslint": "^9.4.0",
    "eslint-import-resolver-typescript": "file:.",
    "pkgroll": "^2.1.1",
    "tsx": "^4.15.4",
    "type-fest": "^4.20.1",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0-alpha.30",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^1.6.0"
  }
}
